{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    // API 계약 타입의 단일 출처. **타입 전용**으로만 쓴다 — 서버리스 함수 코드가
    // 클라이언트 번들에 들어가면 안 되고, type import 는 컴파일 시 사라진다.
    // vite 는 별칭이 필요 없다(런타임 참조가 없으므로) — tsc 해석용 설정이다.
    "baseUrl": ".",
    "paths": {
      "@api/*": ["../../api/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
